matches the snapshot with both sources enabled:
  1: |
    exporters:
      otlp_http:
        endpoint: http://gateway.example.com:4318
        sending_queue:
          storage: file_storage
    extensions:
      file_storage:
        compaction:
          directory: /var/lib/otelcol/file_storage
          on_rebound: true
        directory: /var/lib/otelcol/file_storage
        max_size: 268435456
      health_check:
        endpoint: 0.0.0.0:13133
    processors:
      batch:
        send_batch_size: 8192
        timeout: 2s
      groupbyattrs:
        keys:
          - stream
          - log.iostream
          - container.image.name
          - container.image.tag
          - k8s.container.name
          - k8s.pod.name
          - k8s.job.name
          - k8s.namespace.name
          - k8s.node.name
          - service.name
          - service.namespace
          - service.instance.id
          - service.version
      k8s_attributes:
        extract:
          metadata:
            - k8s.namespace.name
            - k8s.pod.name
            - k8s.pod.uid
            - k8s.node.name
            - k8s.pod.start_time
            - k8s.deployment.name
            - k8s.replicaset.name
            - k8s.replicaset.uid
            - k8s.daemonset.name
            - k8s.daemonset.uid
            - k8s.job.name
            - k8s.job.uid
            - k8s.container.name
            - k8s.cronjob.name
            - k8s.statefulset.name
            - k8s.statefulset.uid
            - container.image.tag
            - container.image.name
            - k8s.cluster.uid
            - service.namespace
            - service.name
            - service.version
            - service.instance.id
          otel_annotations: true
        pod_association:
          - sources:
              - from: resource_attribute
                name: k8s.pod.name
              - from: resource_attribute
                name: k8s.namespace.name
        wait_for_metadata: true
        wait_for_metadata_timeout: 10s
      memory_limiter:
        check_interval: 1s
        limit_percentage: 80
        spike_limit_percentage: 25
      transform/common_attributes:
        error_mode: ignore
        log_statements:
          - context: resource
            statements:
              - set(resource.attributes["cloud.provider"], "aws")
              - set(resource.attributes["cloud.region"], resource.attributes["aws.region"])
              - delete_key(resource.attributes, "aws.region")
              - set(resource.attributes["k8s.cluster.name"], "test-cluster")
      transform/controlplane_attributes:
        error_mode: ignore
        log_statements:
          - context: resource
            statements:
              - set(resource.attributes["cloud.platform"], "aws_eks")
              - set(resource.attributes["service.name"], resource.attributes["cloudwatch.log.stream"])
              - |-
                replace_pattern(
                  resource.attributes["service.name"],
                  "(.+)-[^-]+$",
                  "$1"
                )
          - context: log
            statements:
              - set(log.cache, ExtractPatterns(log.body, "^(?P<klogsev>[IWEF])[0-9]{4} "))
              - set(log.severity_text, "info") where log.cache["klogsev"] == "I"
              - set(log.severity_text, "warn") where log.cache["klogsev"] == "W"
              - set(log.severity_text, "error") where log.cache["klogsev"] == "E"
              - set(log.severity_text, "fatal") where log.cache["klogsev"] == "F"
              - set(log.severity_number, SEVERITY_NUMBER_INFO) where log.cache["klogsev"] == "I"
              - set(log.severity_number, SEVERITY_NUMBER_WARN) where log.cache["klogsev"] == "W"
              - set(log.severity_number, SEVERITY_NUMBER_ERROR) where log.cache["klogsev"] == "E"
              - set(log.severity_number, SEVERITY_NUMBER_FATAL) where log.cache["klogsev"] == "F"
      transform/fargate_attributes:
        error_mode: ignore
        log_statements:
          - context: resource
            statements:
              - set(resource.attributes["cloud.platform"], "aws_eks")
          - context: log
            statements:
              - set(log.cache, ParseJSON(log.body))
              - flatten(log.cache)
              - set(log.body, log.cache["log"])
              - set(log.attributes["stream"], log.cache["stream"])
              - set(log.attributes["log.iostream"], log.cache["stream"])
              - set(log.attributes["k8s.pod.name"], log.cache["kubernetes.pod_name"])
              - set(log.attributes["k8s.namespace.name"], log.cache["kubernetes.namespace_name"])
              - set(log.attributes["k8s.container.name"], log.cache["kubernetes.container_name"])
    receivers:
      awscloudwatch/cluster:
        logs:
          groups:
            named:
              /aws/eks/test/cluster: {}
          poll_interval: 10s
        region: eu-west-1
        storage: file_storage
      awscloudwatch/fargate:
        logs:
          groups:
            named:
              /aws/eks/test/fargate: {}
          poll_interval: 10s
        region: eu-west-1
        storage: file_storage
    service:
      extensions:
        - health_check
        - file_storage
      pipelines:
        logs/cluster:
          exporters:
            - otlp_http
          processors:
            - memory_limiter
            - transform/common_attributes
            - transform/controlplane_attributes
            - batch
            - groupbyattrs
          receivers:
            - awscloudwatch/cluster
        logs/fargate:
          exporters:
            - otlp_http
          processors:
            - memory_limiter
            - transform/common_attributes
            - transform/fargate_attributes
            - batch
            - groupbyattrs
            - k8s_attributes
          receivers:
            - awscloudwatch/fargate
      telemetry:
        logs:
          encoding: json
        metrics:
          level: detailed
        resource:
          service.name: ""
          service.version: ""
        traces:
          sampler:
            parent_based:
              root:
                trace_id_ratio_based:
                  ratio: 0.01
