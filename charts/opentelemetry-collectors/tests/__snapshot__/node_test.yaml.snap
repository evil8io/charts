matches the snapshot with aws and fargate enabled:
  1: |
    exporters:
      debug:
        sampling_initial: 5
        sampling_thereafter: 200
        verbosity: detailed
      otlp_http:
        endpoint: http://gateway.example.com:4318
        sending_queue:
          storage: file_storage
    extensions:
      file_storage:
        directory: /var/lib/otelcol
        max_size: 1073741824
    processors:
      batch:
        send_batch_size: 8192
        timeout: 2s
      k8s_attributes:
        extract:
          labels:
            - from: pod
              key: app.kubernetes.io/instance
              tag_name: k8s.app.instance
            - from: pod
              key: app.kubernetes.io/component
              tag_name: k8s.app.component
          metadata:
            - k8s.namespace.name
            - k8s.pod.name
            - k8s.pod.uid
            - k8s.node.name
            - k8s.pod.start_time
            - k8s.deployment.name
            - k8s.replicaset.name
            - k8s.replicaset.uid
            - k8s.daemonset.name
            - k8s.daemonset.uid
            - k8s.job.name
            - k8s.job.uid
            - k8s.container.name
            - k8s.cronjob.name
            - k8s.statefulset.name
            - k8s.statefulset.uid
            - container.image.tag
            - container.image.name
            - k8s.cluster.uid
            - service.namespace
            - service.name
            - service.version
            - service.instance.id
          otel_annotations: true
        filter:
          node_from_env_var: OTEL_K8S_NODE_NAME
        passthrough: false
        pod_association:
          - sources:
              - from: resource_attribute
                name: k8s.pod.uid
          - sources:
              - from: resource_attribute
                name: k8s.pod.name
              - from: resource_attribute
                name: k8s.namespace.name
              - from: resource_attribute
                name: k8s.node.name
          - sources:
              - from: resource_attribute
                name: k8s.pod.ip
          - sources:
              - from: resource_attribute
                name: k8s.pod.name
              - from: resource_attribute
                name: k8s.namespace.name
          - sources:
              - from: connection
        wait_for_metadata: true
        wait_for_metadata_timeout: 10s
      resource_detection/env:
        detectors:
          - env
          - eks
          - k8s_api
        eks:
          node_from_env_var: K8S_NODE_NAME
          resource_attributes:
            cloud.account.id:
              enabled: true
            cloud.availability_zone:
              enabled: true
            cloud.region:
              enabled: true
            host.id:
              enabled: true
            host.image.id:
              enabled: true
            host.type:
              enabled: true
            k8s.cluster.name:
              enabled: true
        fail_on_missing_metadata: true
        override: false
        timeout: 15s
      transform/delete_attributes:
        error_mode: ignore
        log_statements:
          - context: log
            statements:
              - delete_key(log.attributes, "log.file.path")
    receivers:
      file_log:
        exclude: []
        include:
          - /var/log/pods/*/*/*.log
        include_file_name: false
        include_file_path: true
        operators:
          - id: container-parser
            max_log_size: 102400
            type: container
        retry_on_failure:
          enabled: true
        skip_unmodified_files: true
        start_at: end
        storage: file_storage
      otelarrow:
        protocols:
          grpc:
            endpoint: 0.0.0.0:4317
            keepalive:
              server_parameters:
                max_connection_age: 1m
                max_connection_age_grace: 10m
      otlp:
        protocols:
          http:
            cors:
              allowed_headers:
                - '*'
              allowed_origins:
                - '*'
              max_age: 7200
            endpoint: 0.0.0.0:4318
            include_metadata: true
      prometheus:
        config:
          global:
            always_scrape_classic_histograms: false
            scrape_native_histograms: true
            scrape_protocols:
              - PrometheusProto
              - PrometheusText0.0.4
              - OpenMetricsText0.0.1
              - OpenMetricsText1.0.0
          scrape_configs:
            - bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
              honor_labels: true
              honor_timestamps: true
              job_name: kubelet
              kubernetes_sd_configs:
                - role: node
              metric_relabel_configs:
                - replacement: opentelemetry-collector/kubelet
                  target_label: job
                - action: drop
                  regex: (csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)
                  source_labels:
                    - __name__
                    - le
              metrics_path: /metrics
              relabel_configs:
                - action: drop
                  regex: fargate
                  source_labels:
                    - __meta_kubernetes_node_label_eks_amazonaws_com_compute_type
                - action: replace
                  regex: (.+):(.+)
                  replacement: ${1}:10250
                  source_labels:
                    - __address__
                  target_label: __address__
                - source_labels:
                    - __meta_kubernetes_node_name
                  target_label: node
              scheme: https
              scrape_interval: 30s
              tls_config:
                insecure_skip_verify: true
            - bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
              honor_labels: true
              honor_timestamps: true
              job_name: kubelet-cadvisor
              kubernetes_sd_configs:
                - role: node
              metric_relabel_configs:
                - replacement: opentelemetry-collector/kubelet
                  target_label: job
                - action: drop
                  regex: container_cpu_(load_average_10s|system_seconds_total|user_seconds_total)
                  source_labels:
                    - __name__
                - action: drop
                  regex: container_fs_(io_current|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)
                  source_labels:
                    - __name__
                - action: drop
                  regex: container_memory_(failures_total|mapped_file|swap)
                  source_labels:
                    - __name__
                - action: drop
                  regex: container_(file_descriptors|tasks_state|threads_max)
                  source_labels:
                    - __name__
                - action: drop
                  regex: container_spec.*
                  source_labels:
                    - __name__
                - action: drop
                  regex: .+;
                  source_labels:
                    - id
                    - pod
              metrics_path: /metrics/cadvisor
              relabel_configs:
                - action: drop
                  regex: fargate
                  source_labels:
                    - __meta_kubernetes_node_label_eks_amazonaws_com_compute_type
                - action: replace
                  regex: (.+):(.+)
                  replacement: ${1}:10250
                  source_labels:
                    - __address__
                  target_label: __address__
                - source_labels:
                    - __meta_kubernetes_node_name
                  target_label: node
              scheme: https
              scrape_interval: 30s
              tls_config:
                insecure_skip_verify: true
    service:
      extensions:
        - file_storage
      pipelines:
        logs:
          exporters:
            - otlp_http
          processors:
            - k8s_attributes
            - resource_detection/env
            - transform/delete_attributes
            - batch
          receivers:
            - otlp
            - otelarrow
            - file_log
        metrics:
          exporters:
            - otlp_http
          processors:
            - k8s_attributes
            - resource_detection/env
            - batch
          receivers:
            - otlp
            - otelarrow
            - prometheus
        traces:
          exporters:
            - otlp_http
          processors:
            - k8s_attributes
            - resource_detection/env
            - batch
          receivers:
            - otlp
            - otelarrow
      telemetry:
        logs:
          encoding: json
        metrics:
          level: detailed
        resource:
          service.name: ""
          service.version: ""
        traces:
          sampler:
            parent_based:
              root:
                trace_id_ratio_based:
                  ratio: 0.01
