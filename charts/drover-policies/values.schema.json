{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "globalContextEntry": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "tenantRoleKinds": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        },
        "type": "array"
      },
      "description": "The namespaced kinds of one tenant role, as a map from API group to resource plurals.",
      "propertyNames": {
        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
      },
      "type": "object"
    }
  },
  "properties": {
    "externalDns": {
      "additionalProperties": false,
      "properties": {
        "annotationPrefix": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "annotationPrefix"
      ],
      "type": "object"
    },
    "globalContextEntries": {
      "additionalProperties": false,
      "properties": {
        "clusterrolebindings": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "grpcroutes": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "httproutes": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "listenersets": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "namespaces": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "services": {
          "$ref": "#/definitions/globalContextEntry"
        },
        "tlsroutes": {
          "$ref": "#/definitions/globalContextEntry"
        }
      },
      "type": "object"
    },
    "kyverno": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "namespace"
      ],
      "type": "object"
    },
    "platform": {
      "enum": [
        "generic",
        "aws",
        "azure"
      ],
      "type": "string"
    },
    "policies": {
      "additionalProperties": false,
      "properties": {
        "generated-integrity": {
          "$ref": "#/definitions/policy"
        },
        "listenerset-hostname": {
          "$ref": "#/definitions/policy"
        },
        "namespace-metadata": {
          "$ref": "#/definitions/policy"
        },
        "namespace-project": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "nameAnnotation": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "nameAnnotation"
          ],
          "type": "object"
        },
        "namespace-quotas": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "hard",
            "revision"
          ],
          "type": "object"
        },
        "prometheus-monitors": {
          "$ref": "#/definitions/policy"
        },
        "route-hostname": {
          "$ref": "#/definitions/policy"
        }
      },
      "required": [
        "generated-integrity",
        "listenerset-hostname",
        "namespace-metadata",
        "namespace-project",
        "namespace-quotas",
        "prometheus-monitors",
        "route-hostname"
      ],
      "type": "object"
    },
    "rancherUsers": {
      "additionalProperties": false,
      "description": "When enabled is true, Helm installs the ClusterRole drover:users and binds it to the group system:cattle:authenticated. Enable it in the Rancher management cluster only.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "tenantRoles": {
      "additionalProperties": false,
      "description": "The namespaced kinds of the view, edit, and admin tenant roles. The verbs are fixed in the templates.",
      "properties": {
        "admin": {
          "$ref": "#/definitions/tenantRoleKinds"
        },
        "edit": {
          "$ref": "#/definitions/tenantRoleKinds"
        },
        "view": {
          "$ref": "#/definitions/tenantRoleKinds"
        }
      },
      "required": [
        "admin",
        "edit",
        "view"
      ],
      "type": "object"
    }
  },
  "required": [
    "externalDns",
    "globalContextEntries",
    "kyverno",
    "platform",
    "policies",
    "rancherUsers",
    "tenantRoles"
  ],
  "title": "drover-policies values",
  "type": "object"
}
