{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "apiFilter": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "cacheTTL": {
          "minLength": 1,
          "type": "string"
        },
        "fanout": {
          "additionalProperties": false,
          "properties": {
            "concurrency": {
              "minimum": 0,
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            },
            "maxInflight": {
              "minimum": 0,
              "type": "integer"
            },
            "maxInflightPerCaller": {
              "minimum": 0,
              "type": "integer"
            },
            "maxNamespaces": {
              "minimum": 0,
              "type": "integer"
            },
            "maxWatchNamespaces": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "fetchRate": {
          "minimum": 0,
          "type": "number"
        },
        "fetchRatePerCaller": {
          "minimum": 0,
          "type": "number"
        },
        "maxCacheEntries": {
          "minimum": 0,
          "type": "integer"
        },
        "maxWatches": {
          "minimum": 0,
          "type": "integer"
        },
        "maxWatchesPerCaller": {
          "minimum": 0,
          "type": "integer"
        },
        "podDisruptionBudget": {
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "replicaCount": {
          "minimum": 1,
          "type": "integer"
        },
        "resources": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "ciliumNetworkPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayNamespaces": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "clusterProxyConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "global": {
      "properties": {
        "broker": {
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string"
            },
            "aws": {
              "additionalProperties": false,
              "properties": {
                "allowedAccounts": {
                  "items": {
                    "pattern": "^[0-9]{12}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "clusterTokenTTL": {
              "pattern": "^([0-9]+(h|m|s))+$",
              "type": "string"
            },
            "credentials": {
              "additionalProperties": false,
              "properties": {
                "maxTTL": {
                  "pattern": "^([0-9]+(h|m|s))+$",
                  "type": "string"
                },
                "ttl": {
                  "pattern": "^([0-9]+(h|m|s))+$",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "jwtIssuers": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "allowedClaims": {
                    "additionalProperties": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "propertyNames": {
                      "minLength": 1,
                      "not": {
                        "const": "aud"
                      }
                    },
                    "type": "object"
                  },
                  "discoveryUrl": {
                    "pattern": "^https://[^/:]+(/.*)?$",
                    "type": "string"
                  },
                  "requiredClaims": {
                    "items": {
                      "minLength": 1,
                      "not": {
                        "const": "aud"
                      },
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "discoveryUrl",
                  "requiredClaims"
                ],
                "type": "object"
              },
              "propertyNames": {
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "type": "object"
            },
            "loginTokenTTL": {
              "pattern": "^([0-9]+(h|m|s))+$",
              "type": "string"
            },
            "rancherUrl": {
              "pattern": "^(https://[^/:]+)?$",
              "type": "string"
            },
            "trust": {
              "additionalProperties": false,
              "properties": {
                "annotation": {
                  "maxLength": 316,
                  "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
                  "type": "string"
                },
                "maxStatements": {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                "statusAnnotation": {
                  "maxLength": 316,
                  "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "hostnames": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "parentRefs": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "rancherBackendRef": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "timeouts": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "openbao": {
      "type": "object"
    },
    "otlp": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "projectPolicy": {
      "additionalProperties": false,
      "properties": {
        "failurePolicy": {
          "enum": [
            "Fail",
            "Ignore"
          ],
          "type": "string"
        },
        "requiredAnnotations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "requiredLabels": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "projectSync": {
      "additionalProperties": false,
      "properties": {
        "annotationKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "interval": {
          "minLength": 1,
          "type": "string"
        },
        "labelKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "nameAnnotation": {
          "type": "string"
        },
        "nameLabel": {
          "type": "string"
        },
        "patchRate": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "resources": {
          "type": "object"
        },
        "serviceAccounts": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "rancher": {
      "additionalProperties": false,
      "properties": {
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "namespace": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "serviceUser": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "additionalProperties": false,
          "description": "The hook Jobs that write and delete the Rancher RBAC of the service user.",
          "properties": {
            "image": {
              "minLength": 1,
              "type": "string"
            },
            "resources": {
              "type": "object"
            }
          },
          "type": "object"
        },
        "password": {
          "additionalProperties": false,
          "properties": {
            "length": {
              "minimum": 12,
              "type": "integer"
            },
            "refreshInterval": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "tokenRotation": {
      "additionalProperties": false,
      "properties": {
        "keep": {
          "minimum": 2,
          "type": "integer"
        },
        "renewBefore": {
          "pattern": "^([0-9]+(h|m|s))+$",
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "schedule": {
          "minLength": 1,
          "type": "string"
        },
        "startingDeadlineSeconds": {
          "minimum": 1,
          "type": "integer"
        },
        "ttl": {
          "pattern": "^([0-9]+(h|m|s))+$",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "rancher"
  ],
  "title": "drover values",
  "type": "object"
}
