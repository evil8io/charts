{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "apiFilter": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "cacheTTL": {
          "minLength": 1,
          "type": "string"
        },
        "fanout": {
          "additionalProperties": false,
          "properties": {
            "concurrency": {
              "minimum": 0,
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            },
            "maxInflight": {
              "minimum": 0,
              "type": "integer"
            },
            "maxInflightPerCaller": {
              "minimum": 0,
              "type": "integer"
            },
            "maxNamespaces": {
              "minimum": 0,
              "type": "integer"
            },
            "maxWatchNamespaces": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "fetchRate": {
          "minimum": 0,
          "type": "number"
        },
        "fetchRatePerCaller": {
          "minimum": 0,
          "type": "number"
        },
        "maxCacheEntries": {
          "minimum": 0,
          "type": "integer"
        },
        "maxWatches": {
          "minimum": 0,
          "type": "integer"
        },
        "maxWatchesPerCaller": {
          "minimum": 0,
          "type": "integer"
        },
        "podDisruptionBudget": {
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "replicaCount": {
          "minimum": 1,
          "type": "integer"
        },
        "resources": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "broker": {
      "additionalProperties": false,
      "properties": {
        "clusterTokenTTL": {
          "pattern": "^([0-9]+(h|m|s))+$",
          "type": "string"
        },
        "credentials": {
          "additionalProperties": false,
          "properties": {
            "maxTTL": {
              "pattern": "^([0-9]+(h|m|s))+$",
              "type": "string"
            },
            "ttl": {
              "pattern": "^([0-9]+(h|m|s))+$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "jwtIssuers": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "discoveryUrl": {
                "pattern": "^https://[^/:]+(/.*)?$",
                "type": "string"
              }
            },
            "required": [
              "discoveryUrl"
            ],
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "type": "object"
        },
        "rancherUrl": {
          "pattern": "^(https://[^/:]+)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ciliumNetworkPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayNamespaces": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "clusterProxyConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "hostnames": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "parentRefs": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "rancherBackendRef": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "timeouts": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "openbao": {
      "type": "object"
    },
    "otlp": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "projectPolicy": {
      "additionalProperties": false,
      "properties": {
        "failurePolicy": {
          "enum": [
            "Fail",
            "Ignore"
          ],
          "type": "string"
        },
        "requiredAnnotations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "requiredLabels": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "projectSync": {
      "additionalProperties": false,
      "properties": {
        "annotationKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "interval": {
          "minLength": 1,
          "type": "string"
        },
        "labelKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "nameAnnotation": {
          "type": "string"
        },
        "nameLabel": {
          "type": "string"
        },
        "patchRate": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "resources": {
          "type": "object"
        },
        "serviceAccounts": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "rancher": {
      "additionalProperties": false,
      "properties": {
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "namespace": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "serviceUser": {
      "additionalProperties": false,
      "properties": {
        "hook": {
          "additionalProperties": false,
          "description": "The hook Jobs that write and delete the Rancher RBAC of the service user.",
          "properties": {
            "image": {
              "minLength": 1,
              "type": "string"
            },
            "resources": {
              "type": "object"
            }
          },
          "type": "object"
        },
        "password": {
          "additionalProperties": false,
          "properties": {
            "length": {
              "minimum": 12,
              "type": "integer"
            },
            "refreshInterval": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "tokenRotation": {
      "additionalProperties": false,
      "properties": {
        "keep": {
          "minimum": 2,
          "type": "integer"
        },
        "renewBefore": {
          "pattern": "^([0-9]+(h|m|s))+$",
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "schedule": {
          "minLength": 1,
          "type": "string"
        },
        "startingDeadlineSeconds": {
          "minimum": 1,
          "type": "integer"
        },
        "ttl": {
          "pattern": "^([0-9]+(h|m|s))+$",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "rancher"
  ],
  "title": "drover values",
  "type": "object"
}
